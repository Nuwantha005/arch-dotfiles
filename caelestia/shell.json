{
    "appearance": {
        "padding": {
            "scale": 1.1
        },
        "spacing": {
            "scale": 1.1
        },
        "transparency": {
            "enabled": true
        }
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": false
        },
        "clock": {
            "background": false,
            "showDate": true
        },
        "status": {
            "showAudio": false,
            "showLockStatus": false
        },
        "workspaces": {
            "activeTrail": false,
            "maxWindowIcons": 5,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "showWindows": false,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 8
        }
    },
    "launcher": {
        "enableDangerousActions": false,
        "useFuzzy": {
            "apps": false,
            "wallpapers": false
        }
    },
    "services": {
        "smartScheme": false,
        "useFahrenheit": false
    },
    "sidebar": {
        "showOnHover": true
    }
}
