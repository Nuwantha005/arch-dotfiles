#!/bin/bash
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║                        HSEARCH - Enhanced File Finder                     ║
# ╚══════════════════════════════════════════════════════════════════════════╝

set -o pipefail

# ─────────────────────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────────────────────
CACHE_DIR="$HOME/.cache/hsearch"
CACHE_FILE="$CACHE_DIR/file_list"
LOCK_FILE="$CACHE_DIR/.cache.lock"
PREVIEW_CACHE="$CACHE_DIR/previews"
PREVIEW_SCRIPT_FILE="$CACHE_DIR/preview.sh"
CLEAR_SCRIPT_FILE="$CACHE_DIR/clear.sh"
SEARCH_PATHS=("$HOME" "/run/media/nuwa/Work" "/run/media/nuwa/Entertainment")
CACHE_MAX_AGE=30  # minutes

# Create directories
mkdir -p "$CACHE_DIR" "$PREVIEW_CACHE"

# ─────────────────────────────────────────────────────────────────────────────
# Cleanup on exit
# ─────────────────────────────────────────────────────────────────────────────
cleanup() {
    find "$PREVIEW_CACHE" -type f -mmin +60 -delete 2>/dev/null
}
trap cleanup EXIT

# ─────────────────────────────────────────────────────────────────────────────
# Cache Management with Locking
# ─────────────────────────────────────────────────────────────────────────────
build_cache() {
    (
        flock -n 200 || exit 0
        
        fd . "${SEARCH_PATHS[@]}" \
            --exclude .git \
            --exclude .cache \
            --exclude node_modules \
            --exclude __pycache__ \
            --exclude .venv \
            --exclude .local/share/Trash \
            --absolute-path \
            --color=never \
            2>/dev/null | sort -u > "$CACHE_FILE.tmp"
        
        mv "$CACHE_FILE.tmp" "$CACHE_FILE"
    ) 200>"$LOCK_FILE"
}

# Check and update cache
if [[ ! -f "$CACHE_FILE" ]]; then
    echo -e "\033[1;33m⏳ Building initial search cache... please wait.\033[0m"
    build_cache
elif [[ $(find "$CACHE_FILE" -mmin +$CACHE_MAX_AGE 2>/dev/null) ]]; then
    build_cache &
fi

# Verify cache exists and has content
if [[ ! -s "$CACHE_FILE" ]]; then
    echo -e "\033[1;31m❌ Cache is empty or still building. Please try again.\033[0m"
    exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# Clear Script (for cleaning up kitty graphics)
# ─────────────────────────────────────────────────────────────────────────────
cat > "$CLEAR_SCRIPT_FILE" << 'CLEAR_SCRIPT_EOF'
#!/bin/bash
# Clear all kitty graphics
printf "\033_Ga=d,d=A\033\\"
CLEAR_SCRIPT_EOF
chmod +x "$CLEAR_SCRIPT_FILE"

# ─────────────────────────────────────────────────────────────────────────────
# Preview Script
# ─────────────────────────────────────────────────────────────────────────────
cat > "$PREVIEW_SCRIPT_FILE" << 'PREVIEW_SCRIPT_EOF'
#!/bin/bash
file="$1"
COLS="${FZF_PREVIEW_COLUMNS:-80}"
LINES="${FZF_PREVIEW_LINES:-40}"
PREVIEW_CACHE="$HOME/.cache/hsearch/previews"

# ─────────────── Colors & Symbols ───────────────
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_CYAN="\033[36m"
C_YELLOW="\033[33m"
C_GREEN="\033[32m"
C_MAGENTA="\033[35m"
C_RED="\033[31m"
C_BLUE="\033[34m"

# Box drawing
BOX_H="─"
BOX_V="│"
BOX_T="├"
BOX_R="┤"

# ─────────────── Helper Functions ───────────────

count_detail_lines() {
    local file="$1"
    local count=4
    
    case "$file" in
        *.jpg|*.jpeg|*.png|*.gif|*.bmp|*.webp)
            command -v identify &>/dev/null && count=$((count + 1))
            ;;
        *.mp4|*.mkv|*.avi|*.mov|*.webm|*.mp3|*.flac|*.wav|*.ogg)
            command -v ffprobe &>/dev/null && count=$((count + 1))
            ;;
        *.pdf)
            command -v pdfinfo &>/dev/null && count=$((count + 2))
            ;;
    esac
    echo $count
}

draw_separator() {
    local label="${1:-}"
    local width=$((COLS - 2))
    
    if [[ -n "$label" ]]; then
        local label_len=${#label}
        local pad=$(( (width - label_len - 2) / 2 ))
        local line="${C_DIM}${BOX_T}"
        for ((i=0; i<pad; i++)); do line+="$BOX_H"; done
        line+="${C_RESET}${C_BOLD}${C_CYAN} $label ${C_RESET}${C_DIM}"
        for ((i=0; i<pad; i++)); do line+="$BOX_H"; done
        line+="${BOX_R}${C_RESET}"
        echo -e "$line"
    fi
}

format_size() {
    local size=$1
    if (( size >= 1073741824 )); then
        awk "BEGIN {printf \"%.1f GB\", $size/1073741824}"
    elif (( size >= 1048576 )); then
        awk "BEGIN {printf \"%.1f MB\", $size/1048576}"
    elif (( size >= 1024 )); then
        awk "BEGIN {printf \"%.1f KB\", $size/1024}"
    else
        echo "${size} B"
    fi
}

get_icon() {
    case "${1,,}" in
        *.pdf) echo "📕" ;;
        *.doc|*.docx) echo "📘" ;;
        *.xls|*.xlsx) echo "📗" ;;
        *.ppt|*.pptx) echo "📙" ;;
        *.jpg|*.jpeg|*.png|*.gif|*.bmp|*.webp|*.svg|*.ico) echo "🖼️ " ;;
        *.mp4|*.mkv|*.avi|*.mov|*.webm|*.flv) echo "🎬" ;;
        *.mp3|*.flac|*.wav|*.ogg|*.m4a|*.aac) echo "🎵" ;;
        *.zip|*.tar|*.gz|*.xz|*.7z|*.rar|*.bz2) echo "📦" ;;
        *.py) echo "🐍" ;;
        *.js|*.jsx) echo "💛" ;;
        *.ts|*.tsx) echo "💙" ;;
        *.rs) echo "🦀" ;;
        *.go) echo "🐹" ;;
        *.rb) echo "💎" ;;
        *.sh|*.bash|*.zsh) echo "⚙️ " ;;
        *.md|*.markdown) echo "📝" ;;
        *.json) echo "📋" ;;
        *.yaml|*.yml) echo "⚙️ " ;;
        *.html|*.htm) echo "🌐" ;;
        *.css|*.scss|*.sass) echo "🎨" ;;
        *.c|*.h) echo "🔧" ;;
        *.cpp|*.hpp|*.cc) echo "⚙️ " ;;
        *.java) echo "☕" ;;
        *.lua) echo "🌙" ;;
        *.vim) echo "💚" ;;
        *.conf|*.config|*.cfg|*.ini) echo "🔩" ;;
        *.log) echo "📜" ;;
        *.sql|*.db|*.sqlite) echo "🗃️ " ;;
        *.iso|*.img) echo "💿" ;;
        *.ttf|*.otf|*.woff|*.woff2) echo "🔤" ;;
        *) 
            if [[ -d "$1" ]]; then echo "📁"
            elif [[ -x "$1" ]]; then echo "⚡"
            elif [[ -L "$1" ]]; then echo "🔗"
            else echo "📄"
            fi ;;
    esac
}

clear_kitty_graphics() {
    if [[ "$TERM" == *"kitty"* ]]; then
        printf "\033_Ga=d,d=A\033\\"
    fi
}

# ─────────────── Preview Renderers ───────────────

render_image() {
    local img="$1"
    local available_lines="$2"
    local y_start="${3:-0}"
    
    # Always clear previous images first
    clear_kitty_graphics
    
    if [[ "$TERM" == *"kitty"* ]] && command -v kitten &>/dev/null; then
        # Use kitten icat with Unicode placeholders for proper fzf integration
        # This method works correctly within fzf preview panes
        kitten icat \
            --clear \
            --transfer-mode=memory \
            --unicode-placeholder \
            --stdin=no \
            --place="${COLS}x${available_lines}@0x${y_start}" \
            "$img" 2>/dev/null
            
    elif [[ "$TERM" == *"kitty"* ]] && command -v kitty &>/dev/null; then
        # Fallback to kitty +kitten
        kitty +kitten icat \
            --clear \
            --transfer-mode=memory \
            --unicode-placeholder \
            --stdin=no \
            --place="${COLS}x${available_lines}@0x${y_start}" \
            "$img" 2>/dev/null
            
    elif command -v chafa &>/dev/null; then
        # Chafa fallback - works in any terminal
        # Add some padding at top for visual centering
        local img_height=$((available_lines - 2))
        (( img_height < 5 )) && img_height=5
        
        echo ""  # Top padding
        chafa \
            --format=symbols \
            --size="${COLS}x${img_height}" \
            --stretch \
            "$img" 2>/dev/null
    else
        echo -e "${C_DIM}(Image preview requires kitty with icat or chafa)${C_RESET}"
    fi
}

render_pdf() {
    local pdf="$1"
    local max_lines="$2"
    local y_offset="${3:-0}"
    local hash=$(echo "$pdf" | md5sum | cut -d" " -f1)
    local cached_img="$PREVIEW_CACHE/${hash}.png"
    
    if [[ -f "$cached_img" ]] && [[ "$cached_img" -nt "$pdf" ]]; then
        render_image "$cached_img" "$max_lines" "$y_offset"
        return
    fi
    
    if command -v pdftoppm &>/dev/null; then
        pdftoppm -png -f 1 -l 1 -singlefile -rx 150 -ry 150 "$pdf" "${cached_img%.png}" 2>/dev/null
        if [[ -f "$cached_img" ]]; then
            render_image "$cached_img" "$max_lines" "$y_offset"
            return
        fi
    fi
    
    if command -v mutool &>/dev/null; then
        mutool draw -o "$cached_img" -F png -r 150 "$pdf" 1 2>/dev/null
        if [[ -f "$cached_img" ]]; then
            render_image "$cached_img" "$max_lines" "$y_offset"
            return
        fi
    fi
    
    echo -e "${C_DIM}(PDF preview requires pdftoppm or mutool)${C_RESET}\n"
    if command -v pdftotext &>/dev/null; then
        pdftotext -l 2 -q "$pdf" - 2>/dev/null | head -n $((max_lines - 2))
    fi
}

render_video() {
    local video="$1"
    local max_lines="$2"
    local y_offset="${3:-0}"
    local hash=$(echo "$video" | md5sum | cut -d" " -f1)
    local cached_img="$PREVIEW_CACHE/${hash}_thumb.png"
    
    if [[ -f "$cached_img" ]] && [[ "$cached_img" -nt "$video" ]]; then
        render_image "$cached_img" "$max_lines" "$y_offset"
        return
    fi
    
    if command -v ffmpegthumbnailer &>/dev/null; then
        ffmpegthumbnailer -i "$video" -o "$cached_img" -s 0 -q 8 2>/dev/null
        if [[ -f "$cached_img" ]]; then
            render_image "$cached_img" "$max_lines" "$y_offset"
        fi
    else
        echo -e "${C_DIM}(Video thumbnails require ffmpegthumbnailer)${C_RESET}"
    fi
}

render_audio() {
    local audio="$1"
    local max_lines="$2"
    local y_offset="${3:-0}"
    local hash=$(echo "$audio" | md5sum | cut -d" " -f1)
    local cached_img="$PREVIEW_CACHE/${hash}_cover.png"
    
    local has_cover=false
    if [[ ! -f "$cached_img" ]] || [[ "$audio" -nt "$cached_img" ]]; then
        if command -v ffmpeg &>/dev/null; then
            ffmpeg -y -i "$audio" -an -vcodec copy "$cached_img" 2>/dev/null && has_cover=true
        fi
    elif [[ -f "$cached_img" ]]; then
        has_cover=true
    fi
    
    if [[ "$has_cover" == true ]] && [[ -f "$cached_img" ]]; then
        render_image "$cached_img" "$((max_lines - 6))" "$y_offset"
    fi
    
    echo ""
    if command -v mediainfo &>/dev/null; then
        mediainfo "$audio" 2>/dev/null | grep -E "^(Track|Album|Performer|Duration|Bit rate)" | head -n 5
    elif command -v ffprobe &>/dev/null; then
        ffprobe -hide_banner "$audio" 2>&1 | grep -E "(Duration|Audio|title|artist|album)" | head -n 5
    fi
}

render_archive() {
    local archive="$1"
    local max_lines="$2"
    
    echo -e "${C_BOLD}${C_CYAN}📦 Archive Contents:${C_RESET}\n"
    
    case "$archive" in
        *.zip) unzip -l "$archive" 2>/dev/null ;;
        *.tar) tar -tf "$archive" 2>/dev/null ;;
        *.tar.gz|*.tgz) tar -tzf "$archive" 2>/dev/null ;;
        *.tar.xz|*.txz) tar -tJf "$archive" 2>/dev/null ;;
        *.tar.bz2|*.tbz2) tar -tjf "$archive" 2>/dev/null ;;
        *.rar) unrar l "$archive" 2>/dev/null ;;
        *.7z) 7z l "$archive" 2>/dev/null ;;
        *) echo "Unknown archive format" ;;
    esac | head -n "$max_lines"
}

render_text() {
    local textfile="$1"
    local max_lines="$2"
    
    # Clear any lingering images when showing text
    clear_kitty_graphics
    
    if command -v bat &>/dev/null; then
        bat --color=always --style=numbers,changes \
            --line-range ":$max_lines" \
            --terminal-width="$COLS" \
            "$textfile" 2>/dev/null
    else
        head -n "$max_lines" "$textfile" 2>/dev/null
    fi
}

render_markdown() {
    local mdfile="$1"
    local max_lines="$2"
    
    clear_kitty_graphics
    
    if command -v glow &>/dev/null; then
        glow -s dark -w "$((COLS - 4))" "$mdfile" 2>/dev/null | head -n "$max_lines"
    else
        render_text "$mdfile" "$max_lines"
    fi
}

render_directory() {
    local dir="$1"
    local max_lines="$2"
    
    clear_kitty_graphics
    
    echo -e "${C_BOLD}${C_CYAN}📂 Directory Contents:${C_RESET}\n"
    
    if command -v eza &>/dev/null; then
        eza -la --icons --color=always --group-directories-first \
            --no-permissions --no-user --time-style=relative "$dir" 2>/dev/null | head -n "$max_lines"
    else
        ls -lah --color=always "$dir" 2>/dev/null | head -n "$max_lines"
    fi
}

# ─────────────── Details Panel ───────────────

render_details() {
    local file="$1"
    local icon=$(get_icon "$file")
    local mime=$(file --mime-type -b "$file" 2>/dev/null)
    local filename=$(basename "$file")
    local dirname=$(dirname "$file")
    
    if [[ -e "$file" ]]; then
        local stat_output
        stat_output=$(stat --printf="%s %Y %X %A %h %U %G" "$file" 2>/dev/null)
        read -r size mtime atime perms links owner group <<< "$stat_output"
        
        local size_fmt=$(format_size "$size")
        local mtime_fmt=$(date -d "@$mtime" "+%Y-%m-%d %H:%M" 2>/dev/null)
        
        local name_display="$filename"
        if (( ${#filename} > COLS - 10 )); then
            name_display="${filename:0:$((COLS - 15))}..."
        fi
        echo -e "${C_DIM}${BOX_V}${C_RESET} ${C_BOLD}$icon $name_display${C_RESET}"
        
        echo -e "${C_DIM}${BOX_V}${C_RESET} ${C_CYAN}Type:${C_RESET} ${mime:-unknown}  ${C_CYAN}Size:${C_RESET} $size_fmt"
        
        echo -e "${C_DIM}${BOX_V}${C_RESET} ${C_CYAN}Modified:${C_RESET} $mtime_fmt  ${C_CYAN}Perms:${C_RESET} $perms"
        
        local path_display="$dirname"
        if (( ${#dirname} > COLS - 12 )); then
            path_display="...${dirname: -$((COLS - 15))}"
        fi
        echo -e "${C_DIM}${BOX_V} Path: $path_display${C_RESET}"
        
        case "$file" in
            *.jpg|*.jpeg|*.png|*.gif|*.bmp|*.webp)
                if command -v identify &>/dev/null; then
                    local dims=$(identify -format "%wx%h %[colorspace]" "$file" 2>/dev/null | head -1)
                    [[ -n "$dims" ]] && echo -e "${C_DIM}${BOX_V}${C_RESET} ${C_CYAN}Dimensions:${C_RESET} $dims"
                fi
                ;;
            *.mp4|*.mkv|*.avi|*.mov|*.webm|*.mp3|*.flac|*.wav|*.ogg)
                if command -v ffprobe &>/dev/null; then
                    local duration=$(ffprobe -v quiet -show_entries format=duration \
                        -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null)
                    if [[ -n "$duration" && "$duration" != "N/A" ]]; then
                        local mins=$(awk "BEGIN {printf \"%.0f\", $duration/60}")
                        local secs=$(awk "BEGIN {printf \"%.0f\", $duration%60}")
                        echo -e "${C_DIM}${BOX_V}${C_RESET} ${C_CYAN}Duration:${C_RESET} ${mins}m ${secs}s"
                    fi
                fi
                ;;
            *.pdf)
                if command -v pdfinfo &>/dev/null; then
                    local pages=$(pdfinfo "$file" 2>/dev/null | awk '/^Pages:/ {print $2}')
                    local title=$(pdfinfo "$file" 2>/dev/null | awk -F: '/^Title:/ {gsub(/^[ \t]+/, "", $2); print $2}')
                    [[ -n "$pages" ]] && echo -e "${C_DIM}${BOX_V}${C_RESET} ${C_CYAN}Pages:${C_RESET} $pages"
                    [[ -n "$title" && "$title" != " " ]] && echo -e "${C_DIM}${BOX_V}${C_RESET} ${C_CYAN}Title:${C_RESET} ${title:0:40}"
                fi
                ;;
        esac
    else
        echo -e "${C_DIM}${BOX_V}${C_RESET} ${C_RED}⚠ File not found${C_RESET}"
    fi
}

# ─────────────── Main Preview Logic ───────────────

main() {
    # Always clear graphics at the start of any preview
    clear_kitty_graphics
    
    if [[ -z "$file" ]]; then
        echo -e "${C_DIM}No file selected${C_RESET}"
        exit 0
    fi
    
    if [[ ! -e "$file" ]]; then
        echo -e "${C_DIM}File not found: $file${C_RESET}"
        exit 0
    fi
    
    local detail_lines=$(count_detail_lines "$file")
    local separator_lines=2
    local header_total=$((detail_lines + separator_lines))
    local preview_lines=$((LINES - header_total))
    
    (( preview_lines < 10 )) && preview_lines=10
    
    local mime=$(file --mime-type -b "$file" 2>/dev/null)
    
    # ═══════════════════════════════════════════════════════════════
    # DETAILS SECTION (top)
    # ═══════════════════════════════════════════════════════════════
    render_details "$file"
    
    echo ""
    draw_separator "PREVIEW"
    
    # ═══════════════════════════════════════════════════════════════
    # PREVIEW SECTION
    # ═══════════════════════════════════════════════════════════════
    if [[ -d "$file" ]]; then
        render_directory "$file" "$preview_lines"
    else
        case "${file,,}" in
            *.pdf)
                render_pdf "$file" "$preview_lines" "$header_total"
                ;;
            *.jpg|*.jpeg|*.png|*.gif|*.bmp|*.webp|*.ico|*.tiff|*.tif)
                render_image "$file" "$preview_lines" "$header_total"
                ;;
            *.svg)
                if command -v rsvg-convert &>/dev/null; then
                    local hash=$(echo "$file" | md5sum | cut -d" " -f1)
                    local cached="$PREVIEW_CACHE/${hash}_svg.png"
                    rsvg-convert -w 800 "$file" -o "$cached" 2>/dev/null
                    render_image "$cached" "$preview_lines" "$header_total"
                else
                    render_text "$file" "$preview_lines"
                fi
                ;;
            *.mp4|*.mkv|*.avi|*.mov|*.webm|*.flv|*.wmv|*.m4v)
                render_video "$file" "$preview_lines" "$header_total"
                ;;
            *.mp3|*.flac|*.wav|*.ogg|*.m4a|*.aac|*.wma|*.opus)
                render_audio "$file" "$preview_lines" "$header_total"
                ;;
            *.zip|*.tar|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.bz2|*.tbz2|*.rar|*.7z|*.gz|*.xz|*.bz2)
                render_archive "$file" "$preview_lines"
                ;;
            *.md|*.markdown)
                render_markdown "$file" "$preview_lines"
                ;;
            *)
                if [[ "$mime" == text/* ]] || file "$file" 2>/dev/null | grep -qE "text|ASCII|UTF-8"; then
                    render_text "$file" "$preview_lines"
                else
                    echo -e "${C_DIM}Binary file - hex dump:${C_RESET}\n"
                    xxd "$file" 2>/dev/null | head -n "$((preview_lines - 2))"
                fi
                ;;
        esac
    fi
}

main
PREVIEW_SCRIPT_EOF

chmod +x "$PREVIEW_SCRIPT_FILE"

RELOAD_SCRIPT_FILE="$CACHE_DIR/reload.sh"

cat > "$RELOAD_SCRIPT_FILE" << EOF
#!/bin/bash
fd . ${SEARCH_PATHS[@]} \\
    --exclude .git \\
    --exclude .cache \\
    --exclude node_modules \\
    --exclude __pycache__ \\
    --exclude .venv \\
    --exclude .local/share/Trash \\
    --absolute-path \\
    --color=never \\
    2>/dev/null | sort -u | tee "$CACHE_FILE"
EOF
chmod +x "$RELOAD_SCRIPT_FILE"

# ─────────────────────────────────────────────────────────────────────────────
# FZF Execution
# ─────────────────────────────────────────────────────────────────────────────
selected=$(fzf \
    --ansi \
    --layout=reverse \
    --border=rounded \
    --border-label=" 🚀 HSEARCH " \
    --border-label-pos=3 \
    --margin=1,2 \
    --padding=1 \
    --prompt="  Search › " \
    --pointer="▶" \
    --marker="✓" \
    --header='╭─────────────────────────────────────────────────────────────────╮
│  CTRL-P: Toggle Preview  │  CTRL-D: Full Details                │
│  CTRL-R: Refresh Cache   │  CTRL-Y: Copy Path                   │
╰─────────────────────────────────────────────────────────────────╯' \
    --color='fg:#cdd6f4,fg+:#f5e0dc,bg:#1e1e2e,bg+:#313244' \
    --color='hl:#f38ba8,hl+:#f38ba8,info:#cba6f7,marker:#a6e3a1' \
    --color='prompt:#89b4fa,spinner:#f5c2e7,pointer:#f5c2e7,header:#6c7086' \
    --color='border:#89b4fa,label:#89b4fa,query:#f5c2e7' \
    --color='preview-bg:#181825,preview-border:#45475a' \
    --preview-window='right:55%:border-rounded' \
    --preview="'$PREVIEW_SCRIPT_FILE' {}" \
    --bind="ctrl-p:change-preview-window(hidden|right:55%:border-rounded)+execute-silent(printf '\033_Ga=d,d=A\033\\\\')" \
    --bind="ctrl-d:transform:[[ \$FZF_PREVIEW_LABEL =~ DETAILS ]] && \
echo \"change-preview-window(hidden)\" || \
echo \"change-preview-window(right:55%:border-rounded)+change-preview-label( DETAILS )+change-preview(printf '\033_Ga=d,d=A\033\\\\' && stat {} 2>/dev/null && echo '' && echo 'MIME Type:' \\\$(file --mime-type -b {} 2>/dev/null) && echo 'Full Type:' \\\$(file -b {} 2>/dev/null))\"" \
    --bind="ctrl-r:reload('$RELOAD_SCRIPT_FILE')+clear-query" \
    --bind='ctrl-y:execute-silent(echo -n {} | wl-copy)+bell' \
    --bind='ctrl-o:execute-silent(nohup xdg-open "$(dirname {})" >/dev/null 2>&1 &)' \
    --bind="?:change-preview-window(right:55%:border-rounded)+change-preview-label( PREVIEW )+change-preview($PREVIEW_SCRIPT_FILE {})" \
    < "$CACHE_FILE"
)

# ─────────────────────────────────────────────────────────────────────────────
# Final cleanup - clear any remaining graphics
# ─────────────────────────────────────────────────────────────────────────────
printf "\033_Ga=d,d=A\033\\"

# ─────────────────────────────────────────────────────────────────────────────
# Open Selected File
# ─────────────────────────────────────────────────────────────────────────────
if [[ -n "$selected" ]]; then
    mime=$(file --mime-type -b "$selected" 2>/dev/null)
    
    if [[ -d "$selected" ]]; then
        if [[ -t 1 ]] && [[ "$SHLVL" -gt 1 ]]; then
            cd "$selected" && exec $SHELL
        else
            # Default for keybindings/GUI
            setsid xdg-open "$selected" >/dev/null 2>&1 &
        fi    elif [[ "$mime" == text/* ]] || [[ "$selected" =~ \.(md|py|js|jsx|ts|tsx|sh|bash|zsh|json|yaml|yml|toml|txt|conf|cfg|vim|lua|rs|go|c|cpp|h|hpp|java|rb|php|html|css|scss)$ ]]; then
        if command -v kitty &>/dev/null; then
            kitty --detach nvim "$selected"
        else
            nvim "$selected"
        fi
    else
        setsid xdg-open "$selected" >/dev/null 2>&1 &
    fi
    
    sleep 0.1
fi
