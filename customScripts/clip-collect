#!/usr/bin/env bash

# clip-collect: Collect all text/markdown files in a directory and copy to clipboard

TARGET_DIR="${1:-.}"

if [[ ! -d "$TARGET_DIR" ]]; then
  echo "Error: '$TARGET_DIR' is not a directory." >&2
  exit 1
fi

if ! command -v wl-copy &>/dev/null; then
  echo "Error: wl-copy not found. Install wl-clipboard." >&2
  exit 1
fi

EXTENSIONS=("md" "txt" "rst" "org" "csv" "json" "yaml" "yml" "toml" "log" "tex")

# Build find expression for extensions
find_args=()
for ext in "${EXTENSIONS[@]}"; do
  find_args+=(-o -name "*.${ext}")
done
# Remove leading -o
find_args=("${find_args[@]:1}")

output=""
first=true

while IFS= read -r -d '' file; do
  filename=$(basename "$file")
  relpath="${file#$TARGET_DIR/}"

  if [[ "$first" == true ]]; then
    first=false
  else
    output+=$'\n\n'
  fi

  output+="${relpath}:"$'\n'
  output+="$(cat "$file")"

done < <(find "$TARGET_DIR" -maxdepth 1 -type f \( "${find_args[@]}" \) -print0 | sort -z)

if [[ -z "$output" ]]; then
  echo "No matching files found in '$TARGET_DIR'." >&2
  exit 1
fi

echo "$output" | wl-copy

# Stats
char_count=${#output}
word_count=$(echo "$output" | wc -w)
line_count=$(echo "$output" | wc -l)
file_count=$(find "$TARGET_DIR" -maxdepth 1 -type f \( "${find_args[@]}" \) | wc -l)

echo "✓ Copied to clipboard"
echo "  Files  : $file_count"
echo "  Lines  : $line_count"
echo "  Words  : $word_count"
echo "  Chars  : $char_count"
